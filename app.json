{
  "expo": {
    "name": "Chall",
    "slug": "Chall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chall",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,

      "bundleIdentifier": "com.konanisaac.Chall"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "package": "com.konanisaac.Chall"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/chall-mark-dark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/chall-mark-light.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "react-native-fast-tflite",
      "expo-font",
      "expo-secure-store",
      "@clerk/expo",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#A3E637",
          "sounds": [
            "./assets/sounds/notif_1.wav",
            "./assets/sounds/notif_2.wav",
            "./assets/sounds/notif_3.wav",
            "./assets/sounds/succes_ot_notif.wav",
            "./assets/sounds/money_cash.wav",
            "./assets/sounds/error.wav"
          ]
        }
      ],
      "expo-media-library",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5400b183-6895-4545-b91a-eda80d567cae"
      }
    }
  }
}
